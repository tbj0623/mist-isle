{
  "name": "mist-isle",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "雾岛突围 MIST ISLE — 原创低多边形俯视角战术竞技，Android + 浏览器双端",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "dev": "node scripts/build.mjs && node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "prettier --check \"client/**/*.{js,css,html}\" \"shared/**/*.mjs\" \"server/**/*.mjs\" \"scripts/**/*.{mjs,js}\" \"tests/**/*.mjs\" \"*.{mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "format": "prettier --write \"client/**/*.{js,css,html}\" \"shared/**/*.mjs\" \"server/**/*.mjs\" \"scripts/**/*.{mjs,js}\" \"tests/**/*.mjs\" \"*.{mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "precommit": "node scripts/precommit.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:compare": "node scripts/perf-compare.mjs",
    "perf:alloc": "node scripts/perf-alloc.mjs",
    "soak": "node scripts/soak.mjs",
    "load-test": "node scripts/load-test.mjs",
    "ai:bench": "node scripts/ai-bench.mjs",
    "ai:bench:paired": "node scripts/ai-bench-paired.mjs",
    "horde:sim": "node scripts/horde-sim.mjs",
    "balance": "node scripts/balance-report.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "audio:check": "node scripts/audio-check.mjs",
    "feel:check": "node scripts/feel-check.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "ux:audit": "node scripts/ux-audit.mjs",
    "css:check": "node scripts/css-check.mjs",
    "css:shots": "node scripts/css-shots.mjs",
    "cta:audit": "node scripts/cta-audit.mjs",
    "map:compare": "node scripts/map-compare.mjs",
    "map:sheet": "node scripts/map-compare-sheet.mjs",
    "analytics:seed": "node scripts/analytics-seed.mjs",
    "analytics:report": "node scripts/analytics-report.mjs",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "benchmark:wire": "node scripts/benchmark-wire.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "lucide": "1.53.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "three": "0.180.0"
  }
}
