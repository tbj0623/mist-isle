# MIST ISLE release 签名配置模板
#
# 用法：
#   1. 复制成 android/keystore.properties（该文件已在 .gitignore 中，不会入库）
#   2. 用 keytool 生成 keystore（仓库里已有 android/keystore/mist-isle-release.jks 时跳过）
#   3. 填好下面的口令与别名
#
# keytool -genkeypair -v \
#   -keystore android/keystore/mist-isle-release.jks \
#   -alias mist-isle -keyalg RSA -keysize 2048 -validity 10000 \
#   -storepass <STORE_PASS> -keypass <KEY_PASS> \
#   -dname "CN=MIST ISLE, OU=Game, O=MistIsle, L=Shanghai, ST=Shanghai, C=CN"
#
# 缺这个文件时 build.gradle 会自动回退到 debug 签名，assembleRelease 依然能出包，
# 只是不能上架商店（Google Play 拒绝 debug 证书签名的包）。

storeFile=keystore/mist-isle-release.jks
storePassword=CHANGE_ME
keyAlias=mist-isle
keyPassword=CHANGE_ME
